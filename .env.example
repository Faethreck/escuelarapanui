# Admin Panel Configuration
# Set a secure password for the admin panel
ADMIN_PASSWORD=your_secure_password_here

# Optional: If you want to use a pre-hashed password (more secure)
# Generate hash using: node -e "const bcrypt=require('bcryptjs');bcrypt.hash('your_password',10).then(h=>console.log(h))"
# ADMIN_PASSWORD_HASH=$2a$10$your_hashed_password_here

# JWT Secret for session tokens
# Generate a random secret: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_change_in_production

# Node Environment
NODE_ENV=production
